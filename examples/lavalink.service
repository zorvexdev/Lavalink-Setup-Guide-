[Unit]
Description=Lavalink Audio Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lavalink
Group=lavalink
WorkingDirectory=/opt/lavalink
EnvironmentFile=/etc/lavalink/lavalink.env
ExecStart=/usr/bin/java -Xmx2G -jar /opt/lavalink/Lavalink.jar
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/lavalink/logs

[Install]
WantedBy=multi-user.target
